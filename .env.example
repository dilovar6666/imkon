APP_NAME=IMKON API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://imkon:change_me@localhost:5432/imkon
TEST_DATABASE_URL=postgresql+psycopg://imkon:change_me@localhost:5432/imkon_test
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
EMAIL_CODE_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (необязательно на текущем этапе)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Redis/Celery (будущие фоновые задачи)
REDIS_URL=redis://127.0.0.1:6379/0

# Будущие интеграции
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
